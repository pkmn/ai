{
  "private": true,
  "repository": "github:pkmn/ai",
  "license": "MIT",
  "workspaces": [
    "teams"
  ],
  "dependencies": {
    "@retorquere/bibtex-parser": "<=9.0.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.3",
    "favicons": "^7.3.1",
    "playwright-core": "1.63.0",
    "site": "github:scheibo/static",
    "source-map-support": "^0.5.21",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@pkmn/eslint-config": "^10.0.0",
    "@untitaker/hyperlink": "^0.3.2",
    "stylelint": "17.15",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-standard": "^40.0.0",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "lint": "eslint --cache && stylelint static/*.css && hyperlink public --check-anchors",
    "fix": "eslint --fix && stylelint --fix static/*.css",
    "clean": "rm -rf public build .tsbuildinfo .eslintcache",
    "compile": "tsc -p .",
    "setup": "([ -d node_modules ] || npm install) && npm run compile && node --env-file-if-exists=.env build/tools/setup",
    "build": "npm run compile && node --env-file-if-exists=.env build/static/build",
    "shots": "npm run compile && node --env-file-if-exists=.env build/tools/shots",
    "pkmn": "node --env-file-if-exists=.env build/tools/pkmn",
    "arena": "node --env-file-if-exists=.env build/arena",
    "mock": "node --env-file-if-exists=.env build/tools/mock",
    "dev": "DEV_AUTH=1 PUBLIC_URL=http://localhost:1234 node --env-file-if-exists=.env build/server",
    "start": "node --env-file-if-exists=.env build/server",
    "test": "npm run build && npm run lint",
    "test:integration": "npm run test && vitest test",
    "deploy:reload": "([ ! -x private/sync ] || ./private/sync) && ssh pkmn@pkmn.ai 'cd /home/pkmn/ai && ./deploy reload'",
    "deploy:restart": "([ ! -x private/sync ] || ./private/sync) && ssh pkmn@pkmn.ai 'cd /home/pkmn/ai && ./deploy restart'",
    "deploy": "npm run deploy:restart"
  },
  "stylelint": {
    "extends": [
      "stylelint-config-standard",
      "stylelint-config-rational-order"
    ],
    "rules": {
      "rule-empty-line-before": null
    }
  }
}
