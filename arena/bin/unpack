#!/usr/bin/env python3
# /opt/arena/bin/unpack
# Safe, quota-enforced archive unpacker for native darwin/arm64 bundles (.tar.gz, .tar.xz, .tar.zst)
import hashlib
import os
import shutil
import stat
import subprocess
import sys
import tarfile

MAX_UNPACKED_BYTES = 500 * 1024 * 1024  # 500 MB hard resident size cap
MAX_FILE_COUNT = 25000                  # Inode / decompression bomb cap
CAS_DIR = "/opt/arena/cas/sha256"       # Content-addressed blob store on same APFS container

def fail(dest_dir: str, msg: str, zstd_proc=None) -> None:
    if zstd_proc is not None:
        try:
            zstd_proc.kill()
            zstd_proc.wait(timeout=5)
        except Exception:
            pass
    shutil.rmtree(dest_dir, ignore_errors=True)
    print(f"UNPACK_ERROR: {msg}", file=sys.stderr)
    sys.exit(1)

def deduplicate_file_apfs_cow(file_path: str, cas_dir: str = CAS_DIR) -> None:
    """Deduplicate identical files (>64 KB) across agent versions using APFS Copy-on-Write clones."""
    try:
        st = os.stat(file_path, follow_symlinks=False)
        if not stat.S_ISREG(st.st_mode) or st.st_size < 65536:
            return
        h = hashlib.sha256()
        with open(file_path, "rb") as f:
            while chunk := f.read(1024 * 1024):
                h.update(chunk)
        digest = h.hexdigest()
        shard_dir = os.path.join(cas_dir, digest[:2])
        os.makedirs(shard_dir, exist_ok=True)
        cas_blob = os.path.join(shard_dir, digest)

        if os.path.exists(cas_blob):
            # Replace extracted file with an instant 0-byte APFS CoW clone of the CAS blob
            tmp_path = file_path + ".cow_tmp"
            subprocess.run(["/bin/cp", "-c", cas_blob, tmp_path], check=True)
            os.chmod(tmp_path, stat.S_IMODE(st.st_mode))
            os.replace(tmp_path, file_path)
        else:
            # First time seeing this blob: clone it into the CAS store
            subprocess.run(["/bin/cp", "-c", file_path, cas_blob], check=True)
    except Exception:
        # If cp -c is unsupported or fails on non-APFS dev filesystems, keep the extracted file
        pass

def open_tar_stream(archive_path: str):
    """Open .tar.gz, .tar.xz, or .tar.zst in streaming mode ('r|*')."""
    if archive_path.endswith(".tar.zst") or archive_path.endswith(".tzst"):
        zstd_proc = subprocess.Popen(
            ["zstd", "-dc", archive_path],
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        return tarfile.open(fileobj=zstd_proc.stdout, mode="r|*"), zstd_proc
    return tarfile.open(archive_path, mode="r|*"), None

def ensure_safe_parent_dirs(dest_real: str, rel_path: str, member_name: str) -> str:
    """Create parent directories for rel_path while rejecting any symlink traversal."""
    parts = [p for p in rel_path.split("/") if p and p != "."]
    if not parts:
        fail(dest_real, f"Illegal empty path in archive: {member_name}")
    cur = dest_real
    for part in parts[:-1]:
        if part == "..":
            fail(dest_real, f"Illegal parent traversal in archive: {member_name}")
        cur = os.path.join(cur, part)
        if os.path.islink(cur):
            fail(dest_real, f"Archive path traverses symlink directory: {member_name}")
        if not os.path.exists(cur):
            os.mkdir(cur, 0o755)
        elif not os.path.isdir(cur):
            fail(dest_real, f"Non-directory parent in archive path: {member_name}")
        real_cur = os.path.realpath(cur)
        if real_cur != dest_real and not real_cur.startswith(dest_real + os.sep):
            fail(dest_real, f"Resolved parent escapes destination: {member_name}")
    target_path = os.path.join(cur, parts[-1])
    return target_path

def unpack_bundle(archive_path: str, dest_dir: str, cas_dir: str = CAS_DIR) -> int:
    os.makedirs(dest_dir, exist_ok=True)
    dest_real = os.path.realpath(dest_dir)

    total_bytes = 0
    file_count = 0
    extracted_regular_files = []

    try:
        tf, zstd_proc = open_tar_stream(archive_path)
    except Exception as e:
        fail(dest_real, f"Invalid tar archive: {e}")

    with tf:
        for member in tf:
            file_count += 1
            if file_count > MAX_FILE_COUNT:
                fail(dest_real, f"Archive exceeds max file count ({MAX_FILE_COUNT})", zstd_proc)

            # 1. Normalize path and forbid absolute paths or '..' traversal
            if member.name.startswith("/") or ".." in member.name.split("/"):
                fail(dest_real, f"Illegal path in archive: {member.name}", zstd_proc)
            rel_path = os.path.normpath(member.name)
            if rel_path.startswith(("/", "..")) or "/../" in member.name:
                fail(dest_real, f"Illegal path in archive: {member.name}", zstd_proc)
            if rel_path == ".":
                continue

            target_path = ensure_safe_parent_dirs(dest_real, rel_path, member.name)
            if not os.path.abspath(target_path).startswith(dest_real + os.sep):
                fail(dest_real, f"Path escapes destination: {member.name}", zstd_proc)

            # 2. Forbid device nodes, FIFOs, sockets, and hardlinks outside bundle
            if member.isdev() or member.isfifo() or member.ischr() or member.isblk():
                fail(dest_real, f"Forbidden special file in archive: {member.name}", zstd_proc)

            if member.issym() or member.islnk():
                if os.path.isabs(member.linkname) or ".." in [p for p in member.linkname.split("/") if p]:
                    fail(dest_real, f"Illegal link target: {member.name} -> {member.linkname}", zstd_proc)
                base_dir = os.path.realpath(os.path.dirname(target_path)) if member.issym() else dest_real
                resolved_target = os.path.realpath(os.path.join(base_dir, member.linkname))
                if resolved_target != dest_real and not resolved_target.startswith(dest_real + os.sep):
                    fail(dest_real, f"Symlink/hardlink escapes bundle: {member.name} -> {member.linkname}", zstd_proc)
                if os.path.lexists(target_path):
                    if os.path.isdir(target_path) and not os.path.islink(target_path):
                        fail(dest_real, f"Cannot overwrite directory with link: {member.name}", zstd_proc)
                    os.unlink(target_path)
                if member.issym():
                    os.symlink(member.linkname, target_path)
                else:
                    if os.path.islink(resolved_target) or not os.path.isfile(resolved_target):
                        fail(dest_real, f"Invalid hardlink target: {member.name} -> {member.linkname}", zstd_proc)
                    os.link(resolved_target, target_path)
                continue

            if member.isdir():
                if os.path.islink(target_path):
                    fail(dest_real, f"Cannot overwrite symlink with directory: {member.name}", zstd_proc)
                os.makedirs(target_path, exist_ok=True)
                continue

            if not member.isfile():
                fail(dest_real, f"Unsupported tar entry type: {member.name}", zstd_proc)

            # 3. Stream-extract regular file while enforcing MAX_UNPACKED_BYTES (never follow symlink)
            if os.path.lexists(target_path):
                if os.path.islink(target_path):
                    fail(dest_real, f"Refusing to write regular file through symlink: {member.name}", zstd_proc)
                os.unlink(target_path)
            src = tf.extractfile(member)
            if src is None:
                continue

            fd = os.open(target_path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o644)
            with src, os.fdopen(fd, "wb") as dst:
                while True:
                    chunk = src.read(65536)
                    if not chunk:
                        break
                    total_bytes += len(chunk)
                    if total_bytes > MAX_UNPACKED_BYTES:
                        fail(dest_real, f"Unpacked size exceeds 500 MB cap ({MAX_UNPACKED_BYTES} bytes)", zstd_proc)
                    dst.write(chunk)

            # 4. Strip setuid/setgid/sticky bits; preserve owner rx/r permissions
            mode = stat.S_IMODE(member.mode) & ~(stat.S_ISUID | stat.S_ISGID | stat.S_ISVTX)
            is_exec = bool(mode & stat.S_IXUSR)
            os.chmod(target_path, 0o755 if is_exec else 0o644)
            extracted_regular_files.append(target_path)

    if zstd_proc is not None:
        zstd_proc.wait()
        if zstd_proc.returncode != 0:
            fail(dest_real, "zstd decompression failed")

    # 5. Post-extraction audit: verify every extracted entry and symlink target stays inside dest_real
    for root_dir, dirs, files in os.walk(dest_real, followlinks=False):
        for name in dirs + files:
            p = os.path.join(root_dir, name)
            resolved = os.path.realpath(p)
            if resolved != dest_real and not resolved.startswith(dest_real + os.sep):
                fail(dest_real, f"Post-extraction symlink escapes bundle: {p}")

    # 6. Verify required './run' entrypoint exists at bundle root, is not a symlink, and is executable
    run_entry = os.path.join(dest_real, "run")
    if os.path.islink(run_entry) or not os.path.isfile(run_entry) or not os.access(run_entry, os.X_OK):
        fail(dest_real, "Bundle is missing required executable './run' at root")

    # 7. Deduplicate large weights/libraries across versions via APFS CoW only after full validation
    for fpath in extracted_regular_files:
        if os.path.exists(fpath) and not os.path.islink(fpath):
            deduplicate_file_apfs_cow(fpath, cas_dir)

    # 7. Strip macOS quarantine/extended attributes and ad-hoc codesign Mach-O binaries on Darwin
    if sys.platform == "darwin":
        subprocess.run(["/usr/bin/xattr", "-cr", dest_real], check=False)
        for root_dir, _, files in os.walk(dest_real):
            for fname in files:
                fpath = os.path.join(root_dir, fname)
                if not os.path.islink(fpath) and os.access(fpath, os.X_OK):
                    subprocess.run(
                        ["/usr/bin/codesign", "--force", "--sign", "-", fpath],
                        stdout=subprocess.DEVNULL,
                        stderr=subprocess.DEVNULL,
                        check=False,
                    )

    print(f"UNPACK_OK: {total_bytes} bytes in {file_count} files")
    return total_bytes

if __name__ == "__main__":
    if len(sys.argv) != 3:
        print(f"Usage: {sys.argv[0]} <archive.tar.gz|.tar.xz|.tar.zst> <dest_dir>", file=sys.stderr)
        sys.exit(2)
    cas = os.environ.get("ARENA_CAS_DIR", CAS_DIR)
    unpack_bundle(sys.argv[1], sys.argv[2], cas)
