#!/usr/bin/env bash
# /opt/arena/bin/arena — Unified lifecycle controller for container & native agents
# Usage:
#   arena run     <p1|p2> <container|native> <image_or_agent_id>
#   arena pause   <p1|p2> <container|native>
#   arena resume  <p1|p2> <container|native>
#   arena cleanup <p1|p2> [container|native]

set -euo pipefail

ACTION="${1:-}"
SLOT="${2:-}"
MODE="${3:-}"
TARGET="${4:-}"

if [[ "$SLOT" != "p1" && "$SLOT" != "p2" ]]; then
  echo "Invalid slot: $SLOT (expected p1 or p2)" >&2
  exit 2
fi

SCRATCH_VOL="/Volumes/$(echo "$SLOT" | tr 'a-z' 'A-Z')"
CONTAINER_NAME="arena-${SLOT}"

wipe_scratch() {
  # Clear any user/system immutable or append-only flags (`chflags uchg/uappend/schg`) set by an
  # untrusted agent so `find ... -delete` cannot fail with EPERM and leak state across games.
  sudo -n /usr/bin/chflags -R nouchg,nouappend,noschg "$SCRATCH_VOL" 2>/dev/null || true
  sudo -n /usr/bin/find "$SCRATCH_VOL" -mindepth 1 -delete 2>/dev/null || true
  sudo -n /usr/sbin/chown root:wheel "$SCRATCH_VOL"
  sudo -n /bin/chmod 0700 "$SCRATCH_VOL"
}

case "$ACTION" in
  run)
    wipe_scratch
    if [[ "$MODE" == "container" ]]; then
      rm -f "/opt/arena/state/peak_ram_${SLOT}" 2>/dev/null || true
      podman rm -f -t 0 "$CONTAINER_NAME" >/dev/null 2>&1 || true
      GPU_ARGS=()
      if [[ "${ARENA_PODMAN_GPU:-1}" != "0" ]]; then
        GPU_ARGS+=(--device /dev/dri)
      fi
      exec podman run --rm -i \
        --name "$CONTAINER_NAME" \
        --network=none \
        --read-only \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --cpus=10 \
        --memory=14g \
        --memory-swap=14g \
        --pids-limit=256 \
        "${GPU_ARGS[@]}" \
        --tmpfs /tmp:rw,noexec,nosuid,size=500m \
        --mount "type=bind,src=${SCRATCH_VOL},dst=/scratch,rw" \
        --env TMPDIR=/scratch \
        --env HOME=/scratch \
        "$TARGET"
    elif [[ "$MODE" == "native" ]]; then
      if [[ ! "$TARGET" =~ ^[A-Za-z0-9._-]+$ ]]; then
        echo "Invalid native agent target: $TARGET" >&2
        exit 2
      fi
      AGENT_DIR="/opt/arena/agents/${TARGET}"
      if [[ ! -x "${AGENT_DIR}/run" ]]; then
        echo "Missing executable ${AGENT_DIR}/run" >&2
        exit 2
      fi
      # Run `limit` supervisor as `root` via sudoers so `proc_pid_rusage` enforces the 14 GiB
      # XNU `ri_phys_footprint` cap across all `p1`/`p2` processes while `limit` drops its child
      # directly to `$SLOT` (`initgroups`/`setgid`/`setuid`) and writes `/opt/arena/state/peak_ram_*`.
      rm -f "/opt/arena/state/peak_ram_${SLOT}" 2>/dev/null || true
      cd "$SCRATCH_VOL"
      exec sudo -n /opt/arena/bin/limit "$SLOT" \
        /usr/bin/sandbox-exec \
          -f /opt/arena/etc/sandbox.sb \
          -D "AGENT_RO_DIR=${AGENT_DIR}" \
          -D "AGENT_SCRATCH_DIR=${SCRATCH_VOL}" \
          "${AGENT_DIR}/run"
    else
      echo "Unknown mode: $MODE" >&2
      exit 2
    fi
    ;;

  pause)
    if [[ "$MODE" == "container" ]]; then
      # Poll briefly on initial startup until `podman run` materializes `$CONTAINER_NAME`
      for _ in {1..20}; do
        state="$(podman container inspect -f '{{.State.Status}}' "$CONTAINER_NAME" 2>/dev/null || true)"
        if [[ "$state" == "paused" || "$state" == "exited" || "$state" == "dead" ]]; then
          break
        fi
        if [[ "$state" == "running" ]] && podman pause "$CONTAINER_NAME" >/dev/null 2>&1; then
          break
        fi
        sleep 0.025
      done
    elif [[ "$MODE" == "native" ]]; then
      # Poll briefly on initial startup until `limit` drops its child to UID `$SLOT`
      for _ in {1..20}; do
        if /usr/bin/pgrep -u "$SLOT" >/dev/null 2>&1; then
          sudo -n -u "$SLOT" /usr/bin/killall -STOP -u "$SLOT" 2>/dev/null || true
          break
        fi
        sleep 0.025
      done
    fi
    ;;

  resume)
    if [[ "$MODE" == "container" ]]; then
      podman unpause "$CONTAINER_NAME" >/dev/null 2>&1 || true
    elif [[ "$MODE" == "native" ]]; then
      # Thaw every process owned by p1 or p2 on macOS
      sudo -n -u "$SLOT" /usr/bin/killall -CONT -u "$SLOT" 2>/dev/null || true
    fi
    ;;

  cleanup)
    if [[ -z "$MODE" || "$MODE" == "container" ]]; then
      if [[ "$MODE" == "container" ]]; then
        peak_bytes="$(podman exec "$CONTAINER_NAME" cat /sys/fs/cgroup/memory.peak 2>/dev/null || true)"
        if [[ "$peak_bytes" =~ ^[0-9]+$ ]] && (( peak_bytes > 0 )); then
          echo $(( (peak_bytes + 1048575) / 1048576 )) > "/opt/arena/state/peak_ram_${SLOT}" 2>/dev/null || true
        fi
      fi
      podman rm -f -t 0 "$CONTAINER_NAME" >/dev/null 2>&1 || true
    fi
    if [[ -z "$MODE" || "$MODE" == "native" ]]; then
      # 1. Unconditionally kill every process and background daemon owned by p1 or p2
      sudo -n /usr/bin/killall -9 -u "$SLOT" 2>/dev/null || true

      # 2. Purge any stray System V IPC segments owned by p1 or p2 (`/usr/bin/ipcs` on macOS)
      for id in $(sudo -n /usr/bin/ipcs -m 2>/dev/null | awk -v u="$SLOT" '$5 == u {print $2}'); do
        sudo -n /usr/bin/ipcrm -m "$id" 2>/dev/null || true
      done
      for id in $(sudo -n /usr/bin/ipcs -s 2>/dev/null | awk -v u="$SLOT" '$5 == u {print $2}'); do
        sudo -n /usr/bin/ipcrm -s "$id" 2>/dev/null || true
      done
    fi

    # 3. Wipe all contents of the APFS scratch volume for this slot without shell glob expansion
    wipe_scratch
    ;;

  *)
    echo "Unknown action: $ACTION" >&2
    exit 2
    ;;
esac
