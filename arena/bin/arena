#!/usr/bin/env bash
# /opt/arena/bin/arena — Unified lifecycle controller for container & native agents
# Usage:
#   arena run     <p1|p2> <container|native> <image_or_agent_id>
#   arena pause   <p1|p2> <container|native>
#   arena resume  <p1|p2> <container|native>
#   arena cleanup <p1|p2> [container|native]

set -euo pipefail

ACTION="${1:-}"
SLOT="${2:-}"
MODE="${3:-}"
TARGET="${4:-}"

if [[ "$SLOT" != "p1" && "$SLOT" != "p2" ]]; then
  echo "Invalid slot: $SLOT (expected p1 or p2)" >&2
  exit 2
fi

SCRATCH_DIR="/Volumes/$(echo "$SLOT" | tr 'a-z' 'A-Z')/scratch"
CONTAINER_NAME="arena-${SLOT}"

# Read cgroup peak memory from the Podman VM host WITHOUT executing any binary inside the
# untrusted container (`podman exec`), so a malicious `/bin/cat` can neither hang the daemon nor
# spoof telemetry.
record_container_peak_ram() {
  local cid peak_bytes
  cid="$(podman container inspect -f '{{.Id}}' "$CONTAINER_NAME" 2>/dev/null || true)"
  if [[ ! "$cid" =~ ^[0-9a-f]{12,64}$ ]]; then
    return 0
  fi
  peak_bytes="$(podman machine ssh podman-machine-default \
    "cat /sys/fs/cgroup/machine.slice/libpod-${cid}.scope/memory.peak /sys/fs/cgroup/libpod_parent/libpod-${cid}/memory.peak 2>/dev/null | head -n 1" \
    2>/dev/null || true)"
  if [[ "$peak_bytes" =~ ^[0-9]+$ ]] && (( peak_bytes > 0 )); then
    echo $(( (peak_bytes + 1048575) / 1048576 )) > "/opt/arena/state/peak_ram_${SLOT}" 2>/dev/null || true
  fi
}

kill_native_slot_procs() {
  local pass
  for pass in {1..10}; do
    sudo -n /usr/bin/killall -9 -u "$SLOT" 2>/dev/null || true
    if ! /usr/bin/pgrep -u "$SLOT" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.02
  done
  echo "Failed to terminate lingering processes for UID $SLOT" >&2
  return 1
}

wipe_scratch() {
  # Wipe `/Volumes/P{1,2}/scratch` rather than the APFS volume mount root (`/Volumes/P{1,2}`),
  # where macOS creates SIP/MACF DataVault `.Spotlight-V100` (`EPERM` even for root `find`) and
  # `.fseventsd`/`.Trashes`. Clear immutable/append-only flags and xattrs so nothing persists.
  sudo -n /usr/bin/chflags -R nouchg,nouappend,noschg "$SCRATCH_DIR" 2>/dev/null || true
  sudo -n /usr/bin/find "$SCRATCH_DIR" -mindepth 1 -delete
  sudo -n /usr/bin/xattr -c "$SCRATCH_DIR" 2>/dev/null || true
  sudo -n /usr/sbin/chown root:wheel "$SCRATCH_DIR"
  sudo -n /bin/chmod 0700 "$SCRATCH_DIR"
  if [[ -n "$(sudo -n /usr/bin/find "$SCRATCH_DIR" -mindepth 1 -print -quit)" ]]; then
    echo "Scratch wipe incomplete on $SCRATCH_DIR" >&2
    exit 1
  fi
}

case "$ACTION" in
  run)
    # Terminate any stale container or native slot processes BEFORE wiping scratch so lingering
    # threads cannot write into `$SCRATCH_DIR` after the wipe completes.
    if [[ "$MODE" == "container" ]]; then
      podman rm -f -t 0 "$CONTAINER_NAME" >/dev/null 2>&1 || true
    elif [[ "$MODE" == "native" ]]; then
      kill_native_slot_procs
    else
      echo "Unknown mode: $MODE" >&2
      exit 2
    fi
    wipe_scratch
    rm -f "/opt/arena/state/peak_ram_${SLOT}" 2>/dev/null || true

    if [[ "$MODE" == "container" ]]; then
      exec podman run --rm -i \
        --name "$CONTAINER_NAME" \
        --network=none \
        --read-only \
        --cap-drop=ALL \
        --security-opt=no-new-privileges \
        --cpus=10 \
        --memory=14g \
        --memory-swap=14g \
        --pids-limit=256 \
        --device /dev/dri \
        --tmpfs /tmp:rw,noexec,nosuid,size=500m \
        --mount "type=bind,src=/opt/arena/stats,dst=/opt/arena/stats,ro" \
        --mount "type=bind,src=${SCRATCH_DIR},dst=/scratch,rw" \
        --env TMPDIR=/scratch \
        --env HOME=/scratch \
        --env XDG_CACHE_HOME=/scratch \
        --env PKMN_STATS_DIR=/opt/arena/stats \
        --env OMP_NUM_THREADS=10 \
        --env MKL_NUM_THREADS=10 \
        --env TORCH_NUM_THREADS=10 \
        --env RAYON_NUM_THREADS=10 \
        --env ARENA_MEMORY_LIMIT_MB=14336 \
        "$TARGET"
    else
      if [[ ! "$TARGET" =~ ^[A-Za-z0-9_][A-Za-z0-9._-]*$ || "$TARGET" == *..* ]]; then
        echo "Invalid native agent target: $TARGET" >&2
        exit 2
      fi
      AGENT_DIR="/opt/arena/agents/${TARGET}"
      if [[ ! -f "${AGENT_DIR}/run" || ! -x "${AGENT_DIR}/run" ]]; then
        echo "Missing executable ${AGENT_DIR}/run" >&2
        exit 2
      fi
      # Run `limit` supervisor as `root` via sudoers so `proc_pid_rusage` enforces the 14 GiB
      # XNU `ri_phys_footprint` cap across all `p1`/`p2` processes while `limit` drops its child
      # directly to `$SLOT` (`initgroups`/`setgid`/`setuid`) and writes `/opt/arena/state/peak_ram_*`.
      cd "$SCRATCH_DIR"
      exec sudo -n /opt/arena/bin/limit "$SLOT" \
        /usr/bin/sandbox-exec \
          -f /opt/arena/etc/sandbox.sb \
          -D "AGENT_RO_DIR=${AGENT_DIR}" \
          -D "AGENT_SCRATCH_DIR=${SCRATCH_DIR}" \
          "${AGENT_DIR}/run"
    fi
    ;;

  pause)
    if [[ "$MODE" == "container" ]]; then
      paused=0
      for _ in {1..80}; do
        state="$(podman container inspect -f '{{.State.Status}}' "$CONTAINER_NAME" 2>/dev/null || true)"
        if [[ "$state" == "paused" || "$state" == "exited" || "$state" == "dead" ]]; then
          paused=1
          break
        fi
        if [[ "$state" == "running" ]]; then
          if podman pause "$CONTAINER_NAME" >/dev/null 2>&1; then
            record_container_peak_ram
            paused=1
            break
          fi
        fi
        sleep 0.025
      done
      if (( paused == 0 )); then
        echo "Timed out waiting to pause container $CONTAINER_NAME" >&2
        exit 1
      fi
    elif [[ "$MODE" == "native" ]]; then
      # Wait for `limit` to drop its child to UID `$SLOT`, then converge `killall -STOP` across
      # consecutive process-table snapshots so racing child forks cannot escape `SIGSTOP`.
      saw_procs=0
      converged=0
      prev_snap=""
      for _ in {1..80}; do
        if ! /usr/bin/pgrep -u "$SLOT" >/dev/null 2>&1; then
          if (( saw_procs == 1 )); then
            converged=1
            break
          fi
          sleep 0.025
          continue
        fi
        saw_procs=1
        sudo -n -u "$SLOT" /usr/bin/killall -STOP -u "$SLOT" 2>/dev/null || true
        snap="$(/bin/ps -U "$SLOT" -o pid=,state= 2>/dev/null | awk '{print $1":"substr($2,1,1)}' | sort)"
        if [[ -z "$snap" ]]; then
          converged=1
          break
        fi
        if ! printf '%s\n' "$snap" | grep -qv ':T$'; then
          if [[ "$snap" == "$prev_snap" ]]; then
            converged=1
            break
          fi
          prev_snap="$snap"
        else
          prev_snap=""
        fi
        sleep 0.015
      done
      if (( converged == 0 )); then
        echo "Failed to freeze all processes for UID $SLOT" >&2
        exit 1
      fi
    fi
    ;;

  resume)
    if [[ "$MODE" == "container" ]]; then
      podman unpause "$CONTAINER_NAME" >/dev/null 2>&1 || true
    elif [[ "$MODE" == "native" ]]; then
      sudo -n -u "$SLOT" /usr/bin/killall -CONT -u "$SLOT" 2>/dev/null || true
    fi
    ;;

  cleanup)
    if [[ -z "$MODE" || "$MODE" == "container" ]]; then
      if [[ "$MODE" == "container" ]]; then
        record_container_peak_ram
      fi
      podman rm -f -t 0 "$CONTAINER_NAME" >/dev/null 2>&1 || true
    fi
    if [[ -z "$MODE" || "$MODE" == "native" ]]; then
      # 1. Unconditionally kill every process and background daemon owned by p1 or p2
      kill_native_slot_procs

      # 2. Purge any stray System V IPC segments owned by p1 or p2 (`/usr/bin/ipcs` on macOS)
      for id in $(sudo -n /usr/bin/ipcs -m 2>/dev/null | awk -v u="$SLOT" '$5 == u && $2 ~ /^[0-9]+$/ {print $2}'); do
        sudo -n /usr/bin/ipcrm -m "$id" 2>/dev/null || true
      done
      for id in $(sudo -n /usr/bin/ipcs -s 2>/dev/null | awk -v u="$SLOT" '$5 == u && $2 ~ /^[0-9]+$/ {print $2}'); do
        sudo -n /usr/bin/ipcrm -s "$id" 2>/dev/null || true
      done
    fi

    # 3. Wipe all contents of the APFS scratch volume for this slot without shell glob expansion
    wipe_scratch
    ;;

  *)
    echo "Unknown action: $ACTION" >&2
    exit 2
    ;;
esac
