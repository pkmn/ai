#!/usr/bin/env bash
# /usr/local/bin/tourney-agent — Rootless bubblewrap + GPU runner for GCP Spot VMs
# Invoked over SSH by the pkmn.ai Tournament Arbiter:
#   ssh worker-vm "/usr/local/bin/tourney-agent <agent_id>"
set -euo pipefail

AGENT_ID="${1:?Usage: tourney-agent <agent_id>}"
if [[ ! "$AGENT_ID" =~ ^[A-Za-z0-9._-]+$ ]]; then
  echo "TOURNEY_ERROR: Invalid agent_id ${AGENT_ID}" >&2
  exit 2
fi
ROOTFS="/opt/arena/agents/${AGENT_ID}"

if [[ ! -x "${ROOTFS}/run" ]]; then
  echo "TOURNEY_ERROR: Missing executable ${ROOTFS}/run" >&2
  exit 2
fi

# Prefer killing the agent child before sshd or system services if the 48 GB VM hits OOM
choom -n 500 -- $$ >/dev/null 2>&1 || true

# Save original stderr on FD 3 for preemption signaling without keeping stdout/stderr open on curl
exec 3>&2

# Background watcher: two-step GCE metadata ETag check + long-poll for Spot VM preemption notice.
# Keeping curl's own stdout/stderr redirected away from sshd ensures an orphaned curl never blocks
# SSH channel EOF if the game finishes normally.
watch_preemption() {
  local meta_url="http://metadata.google.internal/computeMetadata/v1/instance/preempted"
  local hdr_file
  hdr_file="$(mktemp /tmp/arena-preempt-hdr.XXXXXX)"
  local initial
  initial=$(curl -s -f --max-time 2 -D "$hdr_file" -H "Metadata-Flavor: Google" \
    "$meta_url" </dev/null 2>/dev/null || true)
  local etag
  etag=$(awk 'tolower($1) == "etag:" { gsub(/[\r\n"]/, "", $2); print $2; exit }' "$hdr_file" 2>/dev/null || true)
  rm -f "$hdr_file"

  if [[ "$initial" == "TRUE" ]]; then
    echo "ARENA_SPOT_PREEMPTED" >&3
    kill -TERM $$ 2>/dev/null || true
    return
  fi
  if [[ -z "$etag" ]]; then
    return
  fi

  local changed
  changed=$(curl -s -f -H "Metadata-Flavor: Google" \
    "${meta_url}?wait_for_change=true&last_etag=${etag}" </dev/null 2>/dev/null || true)
  if [[ "$changed" == "TRUE" ]]; then
    echo "ARENA_SPOT_PREEMPTED" >&3
    kill -TERM $$ 2>/dev/null || true
  fi
}
watch_preemption >/dev/null 2>&1 &
WATCHER_PID=$!
trap 'kill $WATCHER_PID 2>/dev/null || true' EXIT

# Run `tourney-relay` outside `bwrap` so the sandboxed `/run` process in its unshared PID
# namespace cannot see `tourney-relay` in `/proc` or inject control lines into its stderr.
exec /usr/local/bin/tourney-relay \
  bwrap \
    --unshare-all \
    --die-with-parent \
    --clearenv \
    --ro-bind "$ROOTFS" / \
    --proc /proc \
    --dev /dev \
    --dev-bind-try /dev/nvidia0 /dev/nvidia0 \
    --dev-bind-try /dev/nvidiactl /dev/nvidiactl \
    --dev-bind-try /dev/nvidia-uvm /dev/nvidia-uvm \
    --dev-bind-try /dev/nvidia-uvm-tools /dev/nvidia-uvm-tools \
    --dev-bind-try /dev/nvidia-modeset /dev/nvidia-modeset \
    --ro-bind-try /usr/lib/x86_64-linux-gnu/libcuda.so.1 /usr/lib/x86_64-linux-gnu/libcuda.so.1 \
    --ro-bind-try /usr/lib/x86_64-linux-gnu/libnvidia-ml.so.1 /usr/lib/x86_64-linux-gnu/libnvidia-ml.so.1 \
    --ro-bind-try /usr/lib/x86_64-linux-gnu/libnvidia-ptxjitcompiler.so.1 /usr/lib/x86_64-linux-gnu/libnvidia-ptxjitcompiler.so.1 \
    --size 4294967296 --tmpfs /tmp \
    --size 4294967296 --tmpfs /scratch \
    --setenv HOME /scratch \
    --setenv TMPDIR /scratch \
    --setenv ARENA_PONDER 1 \
    --setenv PATH "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin" \
    --chdir / \
    /run
