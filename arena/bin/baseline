#!/usr/bin/env bash
# Built-in baseline opponent for 1-turn offline smoke tests.
set -euo pipefail

while IFS= read -r line; do
  case "$line" in
    \|request\|*)
      payload="${line#\|request\|}"
      if [[ -z "$payload" || "$payload" == "null" || "$payload" == *'"wait":true'* || "$payload" == *'"wait": true'* ]]; then
        continue
      fi
      if [[ "$payload" == *'"teamPreview":true'* || "$payload" == *'"teamPreview": true'* ]]; then
        if [[ "$payload" == *'"maxChosenTeamSize":4'* || "$payload" == *'"maxChosenTeamSize": 4'* ]]; then
          echo "/team 1234"
        else
          echo "/team 123456"
        fi
      else
        echo "default"
      fi
      ;;
  esac
done
