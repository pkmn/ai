#!/bin/sh
# /opt/arena/agents/_baseline/run
# Deterministic baseline stdio agent used as Player 2 during Turn-1 submission smoke tests.
# Uses only POSIX /bin/sh built-ins so it executes inside /opt/arena/etc/sandbox.sb with zero
# external runtime dependencies.

while IFS= read -r line; do
  case "$line" in
    \|tournament\|byot\|*)
      printf '/utm default\n'
      ;;
    \|request\|*)
      req="${line#\|request\|}"
      case "$req" in
        ""|null*|*'"wait":true'*|*'"wait": true'*)
          ;;
        *'"teamPreview":true'*|*'"teamPreview": true'*)
          case "$req" in
            *'"maxChosenTeamSize":4'*|*'"maxChosenTeamSize": 4'*)
              printf '/team 1234\n'
              ;;
            *)
              printf '/team 123456\n'
              ;;
          esac
          ;;
        *)
          printf 'default\n'
          ;;
      esac
      ;;
  esac
done
