# /etc/sudoers.d/arena (mode 0440, owned by root:wheel)
# Allow pkmn to spawn the supervisor and wipe p1/p2 state without a password prompt.
pkmn ALL=(p1,p2) NOPASSWD: /opt/arena/bin/limit *
pkmn ALL=(root) NOPASSWD: /usr/bin/killall -9 -u p1, /usr/bin/killall -9 -u p2
pkmn ALL=(root) NOPASSWD: /bin/rm -rf /Volumes/P1/*, /bin/rm -rf /Volumes/P2/*
pkmn ALL=(root) NOPASSWD: /bin/rm -rf /Volumes/P1/.[!.]*, /bin/rm -rf /Volumes/P2/.[!.]*
pkmn ALL=(root) NOPASSWD: /usr/sbin/ipcs *, /usr/sbin/ipcrm *
pkmn ALL=(root) NOPASSWD: /bin/chmod 1700 /Volumes/P1 /Volumes/P2
