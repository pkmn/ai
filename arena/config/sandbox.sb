;; /opt/arena/etc/sandbox.sb
;; Mandatory Access Control (Seatbelt) profile for native darwin/arm64 agents.
;; Invoked with: sandbox-exec -f /opt/arena/etc/sandbox.sb \
;;   -D AGENT_RO_DIR=/opt/arena/agents/<id> -D AGENT_SCRATCH_DIR=/Volumes/P1 ...
(version 1)
(deny default)

;; 1. Absolutely deny all network and socket operations (IPv4, IPv6, loopback, Unix sockets).
;;    Combined with /etc/pf.anchors/ai.pkmn.arena (and `--network=none` for OCI containers),
;;    agents run in a strictly airgapped environment with zero outbound exfiltration channels
;;    for opponent teams observed during battle.
(deny network*)
(deny system-socket)

;; 2. Allow basic process execution, fork/exec of helper binaries within allowed paths, and signals
;;    restricted to the agent's own sandboxed process tree (`same-sandbox`). Allow general sysctl
;;    hardware/CPU queries while blocking `kern.proc.*` host process-table enumeration except
;;    per-PID `kern.proc.pid.*` self-inspection.
(allow process-fork)
(allow process-info* (target self))
(allow signal (target same-sandbox))
(allow sysctl-read)
(deny sysctl-read
  (sysctl-name-prefix "kern.proc."))
(allow sysctl-read
  (sysctl-name-prefix "kern.proc.pid."))
(allow pseudo-tty)

;; 3. Explicitly deny cross-process Mach/POSIX IPC, keychains, pasteboard, and audio/camera
(deny ipc-posix-shm*)
(deny ipc-posix-sem*)
(deny ipc-sysv*)
(deny mach-priv*)
(deny hid-control)
(deny nvram*)

;; Allow only minimal system Mach services required by dyld, libSystem, Metal, and Neural Engine
(allow mach-lookup
  (global-name "com.apple.system.logger")
  (global-name "com.apple.system.notification_center")
  (global-name "com.apple.CoreServices.coreservicesd")
  (global-name "com.apple.CARenderServer")
  (global-name "com.apple.MTLCompilerService")
  (global-name "com.apple.appleneuralengine"))

;; 4. Allow Apple Silicon GPU / Neural Engine access for local ML inference (PyTorch MPS / MLX)
(allow iokit-open
  (iokit-user-client-class "AGXDeviceUserClient")
  (iokit-user-client-class "AGXCommandQueue")
  (iokit-user-client-class "AGXSharedUserClient")
  (iokit-user-client-class "IOAccelerationUserClient")
  (iokit-user-client-class "IOSurfaceRootUserClient")
  (iokit-user-client-class "H11ANEInDirectPathClient"))

;; 5. Read-only access to macOS system libraries, frameworks, devices, and era-matched stats
(allow file-read-metadata
  (literal "/Volumes")
  (literal "/Library")
  (literal "/opt")
  (literal "/opt/arena")
  (literal "/opt/arena/agents")
  (literal "/var")
  (literal "/tmp")
  (literal "/etc")
  (literal "/private")
  (literal "/private/var")
  (literal "/private/etc"))

(allow file-read*
  (literal "/")
  (literal "/dev/null")
  (literal "/dev/zero")
  (literal "/dev/random")
  (literal "/dev/urandom")
  (subpath "/dev/fd")
  (subpath "/System")
  (subpath "/usr/lib")
  (subpath "/usr/share")
  (subpath "/Library/Apple")
  (subpath "/Library/Frameworks")
  (subpath "/private/var/db/timezone")
  (subpath "/opt/arena/stats"))

(allow file-write-data
  (literal "/dev/null")
  (literal "/dev/zero")
  (subpath "/dev/fd"))

;; 6. Read/execute standard utilities, Homebrew runtimes, and ONLY the specific agent's
;;    immutable bundle directory (never /opt/arena/agents as a whole or /opt/arena/state!)
(allow file-read* process-exec
  (subpath "/bin")
  (subpath "/usr/bin")
  (subpath "/opt/homebrew")
  (subpath (param "AGENT_RO_DIR")))

;; 7. Read/write ONLY the specific player slot's quota-capped APFS scratch volume (/Volumes/P1 or P2),
;;    while denying chflags (`file-write-flags`) so agents cannot set `uchg`/`uappend`.
(allow file-read* file-write* process-exec
  (subpath (param "AGENT_SCRATCH_DIR")))
(deny file-write-flags
  (subpath (param "AGENT_SCRATCH_DIR")))
