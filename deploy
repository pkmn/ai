#!/bin/bash
set -euxo pipefail

# Save our current commit to use for comparison later
HEAD=$(git rev-parse HEAD)

# Pull down latest code
git pull origin main

# Initialize/update teams submodule with only the required format directories
if [ ! -e teams/teams/.git ]; then
    mkdir -p .git/modules/teams
    git submodule init teams/teams
    git clone --depth 1 --filter=blob:none --sparse --separate-git-dir=.git/modules/teams/teams \
        "$(git config submodule.teams/teams.url)" teams/teams
fi
git -C teams/teams sparse-checkout set gen9championsvgc2026regmc
git submodule update --depth 1 teams/teams

# Update dependencies if package.json has changed
git diff --quiet $HEAD package.json teams/package.json >/dev/null ||
    npm install --omit=dev --silent

# Reload unit files if any changes have been made to them
git diff --quiet $HEAD config/*.{service,timer} ||
    sudo systemctl daemon-reload

# Always do a rebuild to regenerate the static pages
npm run build

# Restart services if there have been changes
command=${1:-reload}
[ "${command}" != "restart" ] && git diff --quiet $HEAD server/index.ts ||
    sudo service pkmn.ai-server restart

[ "${command}" != "restart" ] && git diff --quiet $HEAD config/vouch.yml ||
    sudo service pkmn.ai-vouch restart

[ "${command}" != "restart" ] && git diff --quiet $HEAD server/discord.ts config/discord.yml ||
    sudo service pkmn.ai-discord restart

if [ -x private/deploy ]; then
    ./private/deploy
fi

# Reload NGINX if the config has changed
git diff --quiet $HEAD config/nginx.conf ||
    sudo service nginx reload
