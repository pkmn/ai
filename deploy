#!/bin/bash
set -euxo pipefail

# Save our current commit to use for comparison later
HEAD=$(git rev-parse HEAD)

# Pull down latest code
git pull origin main

# Initialize/update teams submodules with only the required directories
for sub in teams/teams teams/pkmn_stuff; do
    if [ ! -e "$sub/.git" ]; then
        mkdir -p .git/modules/teams
        git submodule init "$sub"
        git clone --depth 1 --filter=blob:none --sparse --separate-git-dir=".git/modules/$sub" \
            "$(git config "submodule.$sub.url")" "$sub"
    fi
done
git -C teams/teams sparse-checkout set gen9championsvgc2026regmc
git -C teams/pkmn_stuff sparse-checkout set --no-cone --stdin < teams/pkmn_stuff.txt
git submodule update --depth 1 teams/teams teams/pkmn_stuff

# Update dependencies if package.json has changed
git diff --quiet $HEAD package.json teams/package.json >/dev/null ||
    npm install --omit=dev --silent

# Reload unit files if any changes have been made to them
git diff --quiet $HEAD config/*.{service,timer} ||
    sudo systemctl daemon-reload

# Ensure runtime writable directories exist before build/restart
mkdir -p public wiki chat/logs

# Always do a rebuild to regenerate the static pages
npm run build

# Restart server if there have been changes
command=${1:-reload}
[ "${command}" != "restart" ] && git diff --quiet $HEAD server/ db/ teams/ config/ static/ ||
    sudo service pkmn.ai-server restart

if [ -x private/deploy ]; then
    ./private/deploy
fi

# Validate and reload NGINX if the config has changed
git diff --quiet $HEAD config/nginx.conf ||
    (sudo nginx -t && sudo service nginx reload)
