# End-to-end Arena lifecycle scenario (`test/e2e.test.ts`).
#
# Drives a live Polka HTTP server through pre-launch qualification, opening ladders, smoke test
# failure + Discord DM, one-time encrypted authToken delivery, VGC `min >= 4` pool gating, anchor
# settlement, 14-day cooldowns + locked seasonal team reuse, 3rd-version retirement, Discord role
# sync, seasonal ladder rotation + auto-archival (`teams.json` + `.7z` logs), and auto-quarantine.

reset --seed 20261110

register "0 ERROR" --logo 0-error.png \
  --owner scheibo:pre.10544 --owner coauthor:coauthor.20001 \
  --discord 513513270670262284:scheibo
register "Foul Play" --owner pmariglia:pmariglia.535629 \
  --discord 283674461268344832:pmariglia
register "Mew's Truck" --owner pkmnbotguy:pkmnbotguy.610002 \
  --discord 300000000000000002:batistas_dick
register "Metamon" --owner jakegrigsby:jakegrigsby.610001 \
  --discord 300000000000000001:jakegrigsby
register "AsterAI" --owner asterdev:asterdev.610005 --pending \
  --discord 300000000000000005:asterdev

tournament create 1 --name "Tournament #1: Gen 9 OU" --format gen9ou \
  --games 8 --tables 2 --hardware "GCP L4 Spot" --starts -1d --status completed
tournament create 2 --name "Tournament #2: VGC 2026 Reg M-C OTS BO3" \
  --format gen9championsvgc2026regmc --games 8 --tables 2 \
  --hardware "GCP L4 Spot" --starts -30m --status running

# 1. Pre-launch: ladders are `upcoming` -> Qualified & Pending have submission fieldset disabled
checkpoint pre-launch

# 2. Open RBY & VGC ladders -> Qualified transitions to Eligible
ladder open rby,vgc
checkpoint ladders-open

# 3. Smoke-failing submission -> Discord DM sent -> cooldown is NOT triggered
submit 0-error 0.1.0-bad rby --by scheibo --smoke pending
smoke 0-error@0.1.0-bad --fail --error "Boot failure in 0.1.0-bad"
checkpoint after-smoke-fail

# 4. Submit 0 ERROR 1.0.0 (w/ encrypted authToken) + Foul Play 1.0.0 w/ 20 valid VGC teams
submit 0-error 1.0.0 rby=1660 vgc=1680 --by scheibo \
  --auth-token "Bearer private-r2-token" --smoke pending
submit foul-play 1.0.0 rby=1500 vgc=1500 --by pmariglia --smoke pending
checkpoint pending-auth-token

smoke all --pass
checkpoint two-vgc-agents

# 5. Submit 3rd VGC agent -> VGC `min = 4` still blocks scheduling until 4th VGC agent arrives
submit mews-truck 1.0.0 vgc=1610 --by pkmnbotguy
checkpoint three-vgc-agents

submit metamon 1.0.0 vgc=1560 --by jakegrigsby \
  --url https://r2.example.com/metamon-1.0.0.tar.zst
play 1 --ladder vgc --heartbeats
checkpoint four-vgc-agents

# 6. Set 1500 anchors, settle ladders, advance 14d cooldown, reuse locked VGC teams, retire 3rd ver
ladder anchor rby,vgc foul-play@1.0.0
settle rby --heartbeats
settle vgc

time +14d
time +1h
submit 0-error 1.1.0 rby=1710 vgc=1700 --by scheibo --teams none
settle rby,vgc

time +14d
time +1h
submit 0-error 1.2.0 rby=1780 --by scheibo
checkpoint third-version-retired

settle rby
discord sync
checkpoint discord-synced

# 7. Seasonal VGC rotation -> `settling` -> finish settling -> auto-`archived` + `teams.json`
submit foul-play 1.1.0 vgc=1530 --by pmariglia --teams none
ladder rotate gen9championsvgc2026regmc --archive-name "VGC 2026 Reg M-C" \
  --new gen9championsvgc2027regma --new-name VGC --format gen9championsvgc2026regmc
checkpoint vgc-rotated

settle gen9championsvgc2026regmc
ladder archive gen9championsvgc2026regmc
render
checkpoint vgc-archived

# 8. Runner auto-quarantine -> DMs owner & staff
quarantine mews-truck@1.0.0 --via runner --reason "Crashed in 5 consecutive games"
checkpoint quarantined
