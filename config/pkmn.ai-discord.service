# systemctl enable /home/pkmn/ai/config/pkmn.ai-discord.service

[Unit]
Description=Discord Bot (pkmn.ai)
Requires=network.target
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=5s
EnvironmentFile=/home/pkmn/ai/private/.env
ExecStart=/usr/bin/npm run start:discord
WorkingDirectory=/home/pkmn/ai
StartLimitInterval=0
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=pkmn.ai.discord
User=pkmn
Group=pkmn

[Install]
WantedBy=multi-user.target
