# systemctl enable --now /home/pkmn/ai/config/pkmn.ai-server.service

[Unit]
Description=pkmn.ai server
Requires=network.target
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=5s
Environment=NODE_ENV=production
EnvironmentFile=/home/pkmn/ai/.env
ExecStart=/usr/bin/node /home/pkmn/ai/build/server
ExecStopPost=-/bin/bash -c '[ "${SERVICE_RESULT:-success}" = "success" ] || /usr/bin/node /home/pkmn/ai/build/tools/pkmn notify-staff "pkmn.ai-server exited (${SERVICE_RESULT}, ${EXIT_CODE}=${EXIT_STATUS})" --key server-crash --cooldown 3600'
# `site`'s `fs` helper creates `${process.cwd()}/build/.tmp-*` on import and atomically `rename`s
# rendered stylesheet assets into `/home/pkmn/ai/public`; running with `cwd = /var/lib/pkmn` keeps
# `/home/pkmn/ai/build` read-only under `ProtectHome=read-only` on the same filesystem as `public/`.
WorkingDirectory=/var/lib/pkmn
StartLimitInterval=0
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pkmn.ai.server
User=pkmn
Group=pkmn
# Keep group read/execute (`0640`/`0750`) so `nginx` (`www-data` in group `pkmn`) can serve
# dynamically written `.log`/`.tar`/HTML files in `public/` and `chat/logs/`, while `/var/lib/pkmn`
# is `0700` and SQLite DBs/backups are explicitly `0600`.
UMask=0027
# Isolate the running web daemon in a read-only mount namespace with `PR_SET_NO_NEW_PRIVS` so a
# server compromise cannot invoke `sudo` or modify `config/*`, `deploy`, `build/*`, or `~/.ssh/*`,
# while keeping `npm run deploy` (`ssh pkmn@pkmn.ai`) seamless outside this unit's namespace.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/pkmn -/home/pkmn/ai/public -/home/pkmn/ai/wiki -/home/pkmn/ai/chat

[Install]
WantedBy=multi-user.target