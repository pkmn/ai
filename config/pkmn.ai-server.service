# install -o root -g root -m 0644 /home/pkmn/ai/config/pkmn.ai-server.service /etc/systemd/system/
# systemctl daemon-reload && systemctl enable --now pkmn.ai-server.service

[Unit]
Description=pkmn.ai server
Requires=network.target
After=network.target

[Service]
Type=simple
Restart=always
RestartSec=5s
Environment=NODE_ENV=production
EnvironmentFile=/home/pkmn/ai/.env
ExecStart=/usr/bin/npm start
WorkingDirectory=/home/pkmn/ai
StartLimitInterval=0
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=pkmn.ai.server
User=pkmn
Group=pkmn

[Install]
WantedBy=multi-user.target