# systemctl enable /home/pkmn/ai/config/pkmn.ai-backup.service

[Unit]
Description=Nightly SQLite backup of /var/lib/pkmn/arena.sqlite

[Service]
Type=oneshot
User=pkmn
Group=pkmn
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
InaccessiblePaths=-/home/pkmn/.ssh
ReadWritePaths=/var/lib/pkmn
ExecStart=/bin/bash -euo pipefail -c 'mkdir -p /var/lib/pkmn/backups && ts=$(date -u +%%Y%%m%%dT%%H%%M%%SZ) && tmp="/var/lib/pkmn/backups/arena-$ts.sqlite" && trap "rm -f \"$tmp\"" EXIT && sqlite3 -cmd ".timeout 10000" /var/lib/pkmn/arena.sqlite ".backup $tmp" && zstd -q --rm "$tmp" && find /var/lib/pkmn/backups -name "arena-*.sqlite.zst" -mtime +30 -delete'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pkmn.ai.backup
