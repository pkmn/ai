# install -o root -g root -m 0644 /home/pkmn/ai/config/pkmn.ai-backup.timer /etc/systemd/system/
# systemctl daemon-reload && systemctl enable --now pkmn.ai-backup.timer

[Unit]
Description=Run pkmn.ai SQLite backup nightly at 04:15 UTC

[Timer]
OnCalendar=*-*-* 04:15:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
